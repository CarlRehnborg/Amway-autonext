{
  "manifest_version": 3,
  "name": "Amway AutoNext",
  "version": "1.0.0",
  "description": "Tự động bấm nút Tiếp theo để skip qua các slide khóa học Amway Academy.",
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": ["https://lrs.academy.amway.com.vn/*"],
  "content_scripts": [
    {
      "matches": ["https://lrs.academy.amway.com.vn/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Amway AutoNext"
  }
}
